#include <stdio.h>

int main() {
    int arr[] = {1, 3, 20, 4, 1, 0};
    int n = 6, i;

    for(i = 0; i < n; i++) {
        if((i == 0 || arr[i] >= arr[i - 1]) &&
           (i == n - 1 || arr[i] >= arr[i + 1])) {
            printf("Peak element is %d at index %d\n", arr[i], i);
            break;
        }
    }

    return 0;
}
