#include <stdio.h>

int main() {
    int arr[] = {45, 88, 12, 99, 67};
    int n = 5, i;
    int max = arr[0], min = arr[0];

    for(i = 1; i < n; i++) {
        if(arr[i] > max)
            max = arr[i];
        if(arr[i] < min)
            min = arr[i];
    }

    printf("Maximum = %d\n", max);
    printf("Minimum = %d\n", min);

    return 0;
}
